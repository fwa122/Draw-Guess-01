{
  "name": "pictionary-server",
  "version": "1.0.0",
  "description": "你画我猜游戏服务端",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --targets node18-win-x64 --output ../dist/你画我猜.exe"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "words/**/*.js"
    ],
    "assets": [
      "data/**/*",
      "../public/**/*",
      "node_modules/socket.io/client-dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}
