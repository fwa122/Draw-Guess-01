		margin-bottom: 12px;
	}

	.input {
		background-color: #ffffff;
		border-width: 1px;
		border-color: #e2e8f0;
		border-radius: 8px;
		padding: 12px 16px;
		font-size: 14px;
		color: #1e293b;
	}

	.textarea {
		background-color: #ffffff;
		border-width: 1px;
		border-color: #e2e8f0;
		border-radius: 8px;
		padding: 12px 16px;
		font-size: 14px;
		color: #1e293b;
		height: 100px;
	}

	.button-row {
		display: flex;
		flex-direction: row;
		margin-top: 12px;
	}

	.button-row button {
		flex: 1;
		margin-right: 12px;
	}

	.button-row button:last-child {
		margin-right: 0px;
	}

	.btn-primary {
		background-color: #3b82f6;
		color: #ffffff;
		border-radius: 8px;
		padding: 12px 20px;
		font-size: 14px;
		font-weight: 600;
	}

	.btn-secondary {
		background-color: #64748b;
		color: #ffffff;
		border-radius: 8px;
		padding: 12px 20px;
		font-size: 14px;
		font-weight: 600;
	}

	.btn-danger {
		background-color: #ef4444;
		color: #ffffff;
		border-radius: 8px;
		padding: 12px 20px;
		font-size: 14px;
		font-weight: 600;
	}

	.btn-back {
		background-color: #10b981;
		color: #ffffff;
		border-radius: 8px;
		padding: 12px 20px;
		font-size: 14px;
		font-weight: 600;
	}

	.status-card {
		background-color: #ffffff;
		border-width: 1px;
		border-color: #e2e8f0;
		border-radius: 8px;
		padding: 16px;
	}

	.status-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}

	.status-row:last-child {
		margin-bottom: 0px;
	}

	.status-label {
		font-size: 13px;
		color: #64748b;
		min-width: 120px;
	}

	.status-online {
		font-size: 14px;
		color: #10b981;
		font-weight: 600;
	}

	.status-offline {
		font-size: 14px;
		color: #ef4444;
		font-weight: 600;
	}

	.status-value {
		font-size: 13px;
		color: #1e293b;
	}

	.log-container {
		background-color: #1e293b;
		border-radius: 8px;
		padding: 12px;
		height: 300px;
	}

	.log-item {
		display: flex;
		flex-direction: row;
		margin-bottom: 8px;
	}

	.log-time {
		font-size: 11px;
		color: #64748b;
		min-width: 60px;
	}

	.log-message {
		font-size: 12px;
		color: #e2e8f0;
	}

	.log-info text {
		color: #94a3b8;
	}

	.log-success text {
		color: #10b981;
	}

	.log-error text {
		color: #ef4444;
	}
</style>